# Node modules
**/node_modules/

# Build outputs
**/dist/
**/build/
**/.vite/
**/out/
**/coverage/
**/.cache/
**/.parcel-cache/
**/.next/
**/.nuxt/
**/.svelte-kit/
**/storybook-static/
**/tmp/
**/temp/

# TypeScript incremental artifacts
**/*.tsbuildinfo

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!**/.env.example

# Generated operational MCP skills (machine-specific absolute paths).
# Source of truth is <server>/skill/SKILL.md; these are produced by the installer.
.claude/skills/codebase-index/
.claude/skills/postgres-mcp/
.claude/skills/observe-mcp/
.claude/skills/bitbucket-mcp/

# Local databases and runtime files
*.db
*.db-shm
*.db-wal
# Database backups. `*.db` does not match a suffixed copy such as
# `mcp-local-index-central.db.pre-s40`, and these files are hundreds of megabytes.
*.db.*
!*.db.example

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/*.code-workspace

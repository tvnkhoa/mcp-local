# ── Connection (legacy single-env, still supported) ──────────────────────────
CH_DB_CONNECTION=Server=localhost;Port=5432;Database=CommunicationHubDb;User Id=postgres;Password=postgres;

# ── Read guardrails ───────────────────────────────────────────────────────────
MCP_DB_DEFAULT_LIMIT=500
MCP_DB_MAX_LIMIT=2000
MCP_DB_DEFAULT_TIMEOUT_MS=30000
MCP_DB_MAX_TIMEOUT_MS=60000
# Warn (run_read_query explain:true) when EXPLAIN total cost exceeds this.
PG_EXPLAIN_COST_WARN=1000000

# ── Multi-environment ─────────────────────────────────────────────────────────
# Option A: discover connection strings from .NET appsettings*.json
CH_APPSETTINGS_ROOTS=D:/1.SourceCode/crm/wec.communication-hub/backend/CommunicationHub/src/Web
CH_CONNECTION_NAME=CommunicationHubDb
# Option B (overrides appsettings): declare connections directly
# PG_ENV_DEV=Server=...;Database=...;User Id=...;Password=...;
# PG_ENV_STAGING=Server=...;Database=...;User Id=...;Password=...;
# PG_ENV_PROD=Server=...;Database=...;User Id=...;Password=...;
PG_ALLOWED_ENVIRONMENTS=dev,staging,prod
PG_WRITABLE_ENVIRONMENTS=dev,staging   # prod is ALWAYS read-only, regardless of this
PG_DEFAULT_ENVIRONMENT=dev

# ── Data writes (OFF by default) ──────────────────────────────────────────────
PG_WRITE_ENABLED=false
PG_WRITE_APPROVAL_SECRET=                # OPTIONAL: auto-generated per process when empty (set only to keep tokens valid across restarts)
PG_WRITE_PREVIEW_TTL_MS=900000           # approval token / preview lifetime (15 min)
PG_WRITE_SAMPLE_LIMIT=20

# ── EF Core migrations (OFF by default) ───────────────────────────────────────
PG_MIGRATION_ENABLED=false
CH_DOTNET_PROJECT=D:/1.SourceCode/crm/wec.communication-hub/backend/CommunicationHub/src/Infrastructure
CH_DOTNET_STARTUP_PROJECT=D:/1.SourceCode/crm/wec.communication-hub/backend/CommunicationHub/src/Web
PG_DOTNET_TIMEOUT_MS=120000

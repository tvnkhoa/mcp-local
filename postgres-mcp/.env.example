# postgres-mcp — environment configuration
#
# @generated by scripts/generate-env.mjs from @mcp/manifest — do not edit by hand.
# Run `npm run generate:env` after changing the manifest; `npm run generate:check` fails on drift.
#
# Copy the values you need into the `env` block of your ~/.claude.json server entry (or a
# local .env when running `npm run dev`). Never commit real secrets.
#
# Uncommented lines are what the installer writes for you. Commented lines are tuning knobs:
# the value shown is the server's own fallback, so setting one PINS it — leave it alone unless
# you mean to override.

# --- Connection source (need ONE of these three) ----------------------------
# Connection source. Need ONE of: POSTGRES_CONNECTION | POSTGRES_ENV_* |
# POSTGRES_APPSETTINGS_ROOTS.
# Renamed. Still accepts: CH_DB_CONNECTION.
POSTGRES_CONNECTION=

# Alternative connection source: discover connection strings from .NET
# appsettings*.json.
# Renamed. Still accepts: CH_APPSETTINGS_ROOTS.
POSTGRES_APPSETTINGS_ROOTS=

# Per-env connection strings, declared directly instead of discovered from
# appsettings. Any one satisfies the connection source. `POSTGRES_ENV_*` is a
# family, not a literal var name — the trailing underscore is part of the
# prefix, so POSTGRES_ENVIRONMENT would not count (and no such var exists).
# The legacy `PG_ENV_` prefix is still accepted.
# Renamed. Still accepts: PG_ENV_.
# POSTGRES_ENV_DEV=
# POSTGRES_ENV_STAGING=
# POSTGRES_ENV_PROD=

# Which named connection to pick out of appsettings.
# Renamed. Still accepts: CH_CONNECTION_NAME.
POSTGRES_CONNECTION_NAME=CommunicationHubDb

# --- Environment access -----------------------------------------------------
# Renamed. Still accepts: PG_ALLOWED_ENVIRONMENTS.
POSTGRES_ALLOWED_ENVIRONMENTS=dev

# prod is ALWAYS read-only regardless of this value.
# Renamed. Still accepts: PG_WRITABLE_ENVIRONMENTS.
POSTGRES_WRITABLE_ENVIRONMENTS=

# Renamed. Still accepts: PG_DEFAULT_ENVIRONMENT.
POSTGRES_DEFAULT_ENVIRONMENT=dev

# --- Query bounds -----------------------------------------------------------
# Renamed. Still accepts: MCP_DB_DEFAULT_LIMIT.
POSTGRES_DEFAULT_LIMIT=500

# Renamed. Still accepts: MCP_DB_MAX_LIMIT.
POSTGRES_MAX_LIMIT=2000

# Renamed. Still accepts: MCP_DB_DEFAULT_TIMEOUT_MS.
POSTGRES_DEFAULT_TIMEOUT_MS=30000

# Renamed. Still accepts: MCP_DB_MAX_TIMEOUT_MS.
POSTGRES_MAX_TIMEOUT_MS=60000

# EXPLAIN cost above which a read query is flagged as expensive.
# Renamed. Still accepts: POSTGRES_EXPLAIN_COST_WARN, PG_EXPLAIN_COST_WARN.
# POSTGRES_EXPLAIN_COST_WARN_THRESHOLD=1000000

# --- Data writes (OFF unless enabled) ---------------------------------------
# Data writes (preview→apply→rollback) OFF unless true. Parsed strictly: exact
# "true" or "1".
# Renamed. Still accepts: PG_WRITE_ENABLED.
POSTGRES_WRITE_ENABLED=false

# Auto-generated per process if empty; set to keep tokens valid across
# restarts.
# Renamed. Still accepts: POSTGRES_WRITE_APPROVAL_SECRET,
# PG_WRITE_APPROVAL_SECRET.
# POSTGRES_APPROVAL_SECRET=

# Write-preview lifetime — 15 minutes.
# Renamed. Still accepts: PG_WRITE_PREVIEW_TTL_MS.
# POSTGRES_WRITE_PREVIEW_TTL_MS=900000

# Rows sampled into a write preview.
# Renamed. Still accepts: PG_WRITE_SAMPLE_LIMIT.
# POSTGRES_WRITE_SAMPLE_LIMIT=20

# --- EF Core migrations (OFF unless enabled) --------------------------------
# EF Core migration tooling OFF unless true. Parsed strictly: exact "true" or
# "1".
# Renamed. Still accepts: PG_MIGRATION_ENABLED.
POSTGRES_MIGRATION_ENABLED=false

# Migration-preview lifetime — 1 hour.
# Renamed. Still accepts: PG_MIGRATION_PREVIEW_TTL_MS.
# POSTGRES_MIGRATION_PREVIEW_TTL_MS=3600000

# Path to the EF Core project (the one holding the DbContext).
# Renamed. Still accepts: POSTGRES_DOTNET_PROJECT, CH_DOTNET_PROJECT.
# POSTGRES_MIGRATION_DOTNET_PROJECT=

# Startup project passed to `dotnet ef --startup-project`.
# Renamed. Still accepts: POSTGRES_DOTNET_STARTUP_PROJECT,
# CH_DOTNET_STARTUP_PROJECT.
# POSTGRES_MIGRATION_DOTNET_STARTUP_PROJECT=

# Timeout for a `dotnet ef` invocation.
# Renamed. Still accepts: POSTGRES_DOTNET_TIMEOUT_MS, PG_DOTNET_TIMEOUT_MS.
# POSTGRES_MIGRATION_DOTNET_TIMEOUT_MS=120000

# lock_timeout for every `dotnet ef` session, via Npgsql `Options` (Npgsql
# 5+); also used by migration_dry_run. 0 = off (server default).
# POSTGRES_MIGRATION_LOCK_TIMEOUT_MS=5000

# --- Raw-SQL DDL migrations (OFF unless enabled) ----------------------------
# Raw-SQL DDL migrations (ddl_*) OFF unless true. Parsed strictly: exact
# "true" or "1".
POSTGRES_DDL_ENABLED=false

# Directory of V<yyyymmddhhmmss>__<name>.up.sql / .down.sql files. Needed by
# file-based plans and ddl_create; inline SQL works without it.
# POSTGRES_DDL_MIGRATIONS_DIR=

# lock_timeout per migration. A file's -- mcp:lock-timeout-ms may lower it,
# never raise it.
# POSTGRES_DDL_LOCK_TIMEOUT_MS=5000

# Default statement_timeout per DDL statement — 5 minutes.
# POSTGRES_DDL_STATEMENT_TIMEOUT_MS=300000

# Ceiling for -- mcp:statement-timeout-ms (e.g. a long CREATE INDEX
# CONCURRENTLY) — 1 hour.
# POSTGRES_DDL_MAX_STATEMENT_TIMEOUT_MS=3600000

# DDL-preview lifetime — 1 hour. Freshness at apply is checked by the drift
# guard, not this.
# POSTGRES_DDL_PREVIEW_TTL_MS=3600000

# [schema.]table of a repo's own (filename, checksum) ledger, e.g.
# public.schema_migration. Replaces mcp_ops.ddl_history; the directory then
# holds psql-style NNNN-name.sql files, forward-only, sha256 over raw bytes.
# ADR 0005 Decision 7.
# POSTGRES_DDL_EXTERNAL_LEDGER=

# Comma-separated roles ALTER … OWNER TO may name. Empty refuses every OWNER
# TO; a SUPERUSER/CREATEROLE/BYPASSRLS/REPLICATION role is refused even when
# listed.
# POSTGRES_DDL_OWNER_ROLES=

# Comma-separated prefix.name=value custom settings, set transaction-locally
# before every migration (e.g. aria.expected_market=AU). Core settings are
# refused.
# POSTGRES_DDL_SESSION_SETTINGS=

# [schema.]relation whose presence means the schema already exists. An up plan
# against an EMPTY ledger is refused while it exists (DDL_ADOPTION_REQUIRED).
# POSTGRES_DDL_ADOPTION_SENTINEL=

# --- Node / libpq runtime (external conventions) ----------------------------
# libpq's own TLS mode (`disable` | `require` | `verify-ca` | `verify-full`),
# read by the driver, not by this server. Set it when the target requires TLS
# but the connection string does not say so.
# PGSSLMODE=

# Set to 0 ONLY if the database host presents a self-signed/untrusted TLS
# certificate. This is a Node flag, not a server setting, and it disables
# certificate verification for the WHOLE process — every outbound TLS
# connection, not just Postgres. Prefer `PGSSLMODE=verify-full` with a trusted
# CA.
# NODE_TLS_REJECT_UNAUTHORIZED=

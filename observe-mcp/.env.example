# observe-mcp — OpenObserve log/trace MCP server
# Copy relevant values into the MCP server's `env` block in ~/.claude.json (do NOT
# commit real secrets). These are read from process.env at startup.

# Query API base URL (the OpenObserve UI/API host — NOT the OTLP ingest host).
OBSERVE_BASE_URL=https://observe.easyserv.au:10443

# Organization identifier (from the OpenObserve URL: org_identifier=...).
OBSERVE_ORG=36619ZLzJ9IjUYKMqTT3MJC5A7Z

# Stream names.
OBSERVE_LOG_STREAM=wecrm_dev
OBSERVE_TRACE_STREAM=wecrm_dev

# Auth — choose ONE:
#   (a) pre-encoded Basic token (with or without the "Basic " prefix)
# OBSERVE_AUTH_BASIC=Basic <base64 of email:password>
#   (b) username + password (encoded at startup)
OBSERVE_USERNAME=you@siliconstack.com.au
OBSERVE_PASSWORD=

# Result + time-window caps.
OBSERVE_DEFAULT_SIZE=100
OBSERVE_MAX_SIZE=1000
OBSERVE_DEFAULT_LOOKBACK_MS=3600000
OBSERVE_MAX_LOOKBACK_MS=604800000
OBSERVE_TIMEOUT_MS=30000

# Retry attempts for transient HTTP failures (network / 5xx / 429). 0 disables.
OBSERVE_MAX_RETRIES=2

# Optional projection: comma-separated columns for log/trace queries instead of
# SELECT * (smaller/faster). Unset = SELECT * (schema-safe). A query that names a
# column the stream lacks auto-falls back to SELECT *.
# OBSERVE_LOG_COLUMNS=_timestamp,severity,body,trace_id,span_id,instrumentation_library_name,service_name,exception

# Optional per-profile character caps for the long message/exception fields.
# Defaults shown; verbose keeps full text. exception cap 0 = drop the field.
# OBSERVE_MSG_MAX_NANO=200
# OBSERVE_EXC_MAX_NANO=0
# OBSERVE_MSG_MAX_COMPACT=400
# OBSERVE_EXC_MAX_COMPACT=800
# OBSERVE_MSG_MAX_STANDARD=2000
# OBSERVE_EXC_MAX_STANDARD=6000

# Only if the query host uses a self-signed/untrusted TLS cert (last resort):
# NODE_TLS_REJECT_UNAUTHORIZED=0

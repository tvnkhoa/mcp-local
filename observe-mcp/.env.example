# observe-mcp — environment configuration
#
# @generated by scripts/generate-env.mjs from @mcp/manifest — do not edit by hand.
# Run `npm run generate:env` after changing the manifest; `npm run generate:check` fails on drift.
#
# Copy the values you need into the `env` block of your ~/.claude.json server entry (or a
# local .env when running `npm run dev`). Never commit real secrets.
#
# Uncommented lines are what the installer writes for you. Commented lines are tuning knobs:
# the value shown is the server's own fallback, so setting one PINS it — leave it alone unless
# you mean to override.

# --- Connection -------------------------------------------------------------
# The OpenObserve UI/API host — NOT the OTLP ingest host.
OBSERVE_BASE_URL=

# From the OpenObserve URL: org_identifier=…
OBSERVE_ORG=

OBSERVE_LOG_STREAM=wecrm_dev

OBSERVE_TRACE_STREAM=wecrm_dev

# --- Auth (need EITHER the token OR username+password) ----------------------
# Auth: provide this OR OBSERVE_USERNAME + OBSERVE_PASSWORD. Accepted with or
# without the "Basic " prefix.
OBSERVE_AUTH_BASIC=

OBSERVE_USERNAME=

OBSERVE_PASSWORD=

# --- Result and time-window caps --------------------------------------------
OBSERVE_DEFAULT_SIZE=100

OBSERVE_MAX_SIZE=1000

# 1 hour.
OBSERVE_DEFAULT_LOOKBACK_MS=3600000

# 7 days.
OBSERVE_MAX_LOOKBACK_MS=604800000

OBSERVE_TIMEOUT_MS=30000

# Retries for transient HTTP failures (network / 5xx / 429). 0 disables.
# OBSERVE_MAX_RETRIES=2

# --- Projection -------------------------------------------------------------
# Comma-separated columns instead of SELECT * (smaller/faster). Unset = SELECT
# *, which is schema-safe. A query naming a column the stream lacks auto-falls
# back to SELECT *.
# OBSERVE_LOG_COLUMNS=

# --- Per-profile field caps (characters) ------------------------------------
# Caps the long `message` field per response profile. verbose keeps full text.
# OBSERVE_MSG_MAX_NANO=200

# OBSERVE_MSG_MAX_COMPACT=400

# OBSERVE_MSG_MAX_STANDARD=2000

# OBSERVE_MSG_MAX_VERBOSE=unlimited

# Caps the `exception` field. 0 = drop the field entirely, which is what nano
# does.
# OBSERVE_EXC_MAX_NANO=0

# OBSERVE_EXC_MAX_COMPACT=800

# OBSERVE_EXC_MAX_STANDARD=6000

# OBSERVE_EXC_MAX_VERBOSE=unlimited

# --- Node runtime (last resort) ---------------------------------------------
# Set to 0 ONLY if the query host uses a self-signed/untrusted TLS
# certificate. This is a Node flag, not a server setting, and it disables
# certificate verification for the WHOLE process — every outbound TLS
# connection, not just OpenObserve. Prefer trusting the CA.
# NODE_TLS_REJECT_UNAUTHORIZED=

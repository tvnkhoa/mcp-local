# observe-mcp — environment configuration
#
# @generated by scripts/generate-env.mjs from @mcp/manifest — do not edit by hand.
# Run `npm run generate:env` after changing the manifest; `npm run generate:check` fails on drift.
#
# Copy the values you need into the `env` block of your ~/.claude.json server entry (or a
# local .env when running `npm run dev`). Never commit real secrets.
#
# Uncommented lines are what the installer writes for you. Commented lines are tuning knobs:
# the value shown is the server's own fallback, so setting one PINS it — leave it alone unless
# you mean to override.

# --- Connection -------------------------------------------------------------
# The OpenObserve UI/API host — NOT the OTLP ingest host.
OBSERVE_BASE_URL=

# From the OpenObserve URL: org_identifier=…
OBSERVE_ORG=

OBSERVE_LOG_STREAM=

# Optional. Unset reuses the logs stream NAME, which usually resolves
# correctly anyway because span queries pass the `traces` stream type and
# OpenObserve resolves a name within its type — both live environments run
# this way and return spans. get_trace_spans warns only if that fallback
# actually returns nothing.
OBSERVE_TRACE_STREAM=

# --- Auth (need EITHER the token OR username+password) ----------------------
# Auth: provide this OR OBSERVE_USERNAME + OBSERVE_PASSWORD. Accepted with or
# without the "Basic " prefix.
OBSERVE_AUTH_BASIC=

OBSERVE_USERNAME=

OBSERVE_PASSWORD=

# --- Additional environments ------------------------------------------------
# A family, not a literal var name — the trailing underscore is part of the
# prefix, and the suffix becomes the environment name. Value is a
# `;`-separated spec: `baseUrl=…;org=…;logStream=…;traceStream=…`, optionally
# with `username=`/`password=`/`authBasic=` to override the shared credentials
# for that one environment. Each pair splits on its first `=` only, so a URL
# survives intact. An unknown key is rejected at startup rather than ignored.
# OBSERVE_ENV_SSDEV_AU=
# OBSERVE_ENV_WECRM_AU_PROD=

# Names the environment built from the flat OBSERVE_BASE_URL/ORG/LOG_STREAM
# trio. Set it when that trio is a real named environment (e.g. `ssdev_au`)
# rather than an unnamed default.
# OBSERVE_PRIMARY_ENV_NAME=default

# Which environment answers when a tool call omits `environment`. Validated
# against the configured set — an unknown value falls back to dev, then
# default, then the first registered, rather than breaking every call.
# OBSERVE_DEFAULT_ENVIRONMENT=

# Comma-separated allowlist. Filters at registration, so a name outside it
# does not exist in the server at all. Unset = no filtering.
# OBSERVE_ALLOWED_ENVIRONMENTS=

# --- Discovery --------------------------------------------------------------
# Comma-separated namespace prefixes counted as first-party code when
# classifying a log row's sourceContext. This is what makes discover_services
# able to point at the owning project.
# OBSERVE_APP_NAMESPACE_PREFIXES=CRM.,SS.,SSNet.,WEC,WeCRM.,CommunicationHub.,OSB.,Bmw.,WecSocialAds.

# Comma-separated prefixes treated as framework/library noise. Necessary
# because by raw volume the top log scopes are all framework plumbing, which
# identifies nothing. A context matching neither list is reported as
# `unclassified`, never dropped.
# OBSERVE_FRAMEWORK_NAMESPACE_PREFIXES=Microsoft.,System.,Npgsql,MassTransit,Quartz,Hangfire,Serilog,OpenTelemetry,Rebus,Ocelot,Elsa.,Grpc.,Amazon.,AWSSDK,Azure.,Polly,StackExchange.,MediatR,FluentValidation,Refit,IdentityServer,FFmpeg.

# --- Service identity -------------------------------------------------------
# Log column holding the application name when the OTLP resource does not (a
# Serilog enricher property). Used only for LOGS — the traces stream has no
# such column, and naming an absent column fails the query at plan time, so
# trace queries always use service_name. A logs stream without this column
# downgrades automatically on the first query and reports
# identity.resolved=false.
# OBSERVE_APP_NAME_FIELD=applicationname

# The service_name value that means "the emitter never set service.name" (the
# OTel spec default). Rows carrying it are re-attributed via
# OBSERVE_APP_NAME_FIELD. Set to an empty string to disable resolution
# entirely and go back to raw service_name.
# OBSERVE_UNKNOWN_SERVICE_SENTINEL=unknown_service:dotnet

# --- Result and time-window caps --------------------------------------------
OBSERVE_DEFAULT_SIZE=100

OBSERVE_MAX_SIZE=1000

# 1 hour.
OBSERVE_DEFAULT_LOOKBACK_MS=3600000

# 7 days.
OBSERVE_MAX_LOOKBACK_MS=604800000

OBSERVE_TIMEOUT_MS=30000

# Retries for transient HTTP failures (network / 5xx / 429). 0 disables.
# OBSERVE_MAX_RETRIES=2

# --- Projection -------------------------------------------------------------
# Comma-separated columns instead of SELECT * (smaller/faster). Unset = SELECT
# *, which is schema-safe. A query naming a column the stream lacks auto-falls
# back to SELECT *.
# OBSERVE_LOG_COLUMNS=

# --- Per-profile field caps (characters) ------------------------------------
# Caps the long `message` field per response profile. verbose keeps full text.
# OBSERVE_MSG_MAX_NANO=200

# OBSERVE_MSG_MAX_COMPACT=400

# OBSERVE_MSG_MAX_STANDARD=2000

# OBSERVE_MSG_MAX_VERBOSE=unlimited

# Caps the `exception` field. 0 = drop the field entirely, which is what nano
# does.
# OBSERVE_EXC_MAX_NANO=0

# OBSERVE_EXC_MAX_COMPACT=800

# OBSERVE_EXC_MAX_STANDARD=6000

# OBSERVE_EXC_MAX_VERBOSE=unlimited

# --- Node runtime (last resort) ---------------------------------------------
# Set to 0 ONLY if the query host uses a self-signed/untrusted TLS
# certificate. This is a Node flag, not a server setting, and it disables
# certificate verification for the WHOLE process — every outbound TLS
# connection, not just OpenObserve. Prefer trusting the CA.
# NODE_TLS_REJECT_UNAUTHORIZED=

{
  "name": "communicationhub-observe-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenObserve log/trace MCP server for CommunicationHub (search logs, trace requests by trace id)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/queryBuilder.test.ts src/logParser.test.ts src/response/responseFormatter.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

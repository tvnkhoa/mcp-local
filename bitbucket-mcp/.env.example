# bitbucket-mcp — environment configuration
# Copy the values you need into the `env` block of your ~/.claude.json server entry
# (or a local .env when running `npm run dev`). Never commit real tokens.

# --- Credentials (required) ------------------------------------------------
# Repository / Workspace / Project Access Token from Bitbucket Cloud.
# Scopes required: read:repository, read:pullrequest, write:pullrequest.
# Sent as: Authorization: Bearer <token>
BITBUCKET_ACCESS_TOKEN=

# Workspace slug (the ID in bitbucket.org/<workspace>/...). Required.
BITBUCKET_WORKSPACE=

# --- Optional --------------------------------------------------------------
# Default repository slug so you can omit `repoSlug` on every call.
BITBUCKET_DEFAULT_REPO=

# Override the API base URL (default below).
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0

# Write gate: create_pull_request is DISABLED unless this is "true" or "1".
BITBUCKET_WRITE_ENABLED=false

# Per-request timeout in milliseconds (must be > 0, else default 30000).
BITBUCKET_TIMEOUT_MS=30000

# Retry attempts for transient failures (network / 429 / 5xx). 0 disables.
BITBUCKET_MAX_RETRIES=2

# Default / maximum page size for list endpoints.
BITBUCKET_DEFAULT_PAGELEN=25
BITBUCKET_MAX_PAGELEN=100

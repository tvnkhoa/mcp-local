# bitbucket-mcp — environment configuration
#
# @generated by scripts/generate-env.mjs from @mcp/manifest — do not edit by hand.
# Run `npm run generate:env` after changing the manifest; `npm run generate:check` fails on drift.
#
# Copy the values you need into the `env` block of your ~/.claude.json server entry (or a
# local .env when running `npm run dev`). Never commit real secrets.
#
# Uncommented lines are what the installer writes for you. Commented lines are tuning knobs:
# the value shown is the server's own fallback, so setting one PINS it — leave it alone unless
# you mean to override.

# --- Target -----------------------------------------------------------------
# The ID in bitbucket.org/<workspace>/…
BITBUCKET_WORKSPACE=

# Lets you omit `repoSlug` on every call.
BITBUCKET_DEFAULT_REPO=

# --- Auth (Bearer token OR email + API token) -------------------------------
# Auth: this (Bearer) OR BITBUCKET_EMAIL + BITBUCKET_API_TOKEN (Basic).
# Scopes: read:repository, read:pullrequest, read:pipeline, write:pullrequest;
# write:repository for commit_files and create/delete_branch. A repository
# access token reads only its own repo: other repos and search_code need a
# workspace token or an API token.
BITBUCKET_ACCESS_TOKEN=

# Basic auth needs BOTH this and BITBUCKET_API_TOKEN. An Atlassian API token
# (ATATT…) is a Basic credential, not a Bearer one.
BITBUCKET_EMAIL=

BITBUCKET_API_TOKEN=

# --- Write gate -------------------------------------------------------------
# create_pull_request and add_pull_request_comment are DISABLED unless true.
# The tools are still advertised; the gate is enforced when they are called.
BITBUCKET_WRITE_ENABLED=false

# merge_pull_request is DISABLED unless true (dryRun still works). Merge
# commit only; the repo has no server-side branch protection, so this tool is
# the only guard.
BITBUCKET_MERGE_ENABLED=false

# commit_files_apply is DISABLED unless true (commit_files_preview still
# works). Never force-pushes; refused unless the parent is the branch head.
BITBUCKET_COMMIT_ENABLED=false

# create_branch / delete_branch are DISABLED unless true (dryRun still works).
# Only names on BITBUCKET_COMMIT_BRANCHES; never a shared or main branch.
BITBUCKET_BRANCH_ENABLED=false

# Comma-separated repo:branch globs that commit_files, create_branch and
# delete_branch may write — branches nobody checks out locally, e.g.
# wec.aria:sandbox/*. Empty = none.
# BITBUCKET_COMMIT_BRANCHES=

# Comma-separated repo:branch globs checked out in a shared worktree, e.g.
# wec.aria:develop. Writable; the result carries the local reconcile steps.
# BITBUCKET_COMMIT_SHARED_BRANCHES=

# --- HTTP -------------------------------------------------------------------
# BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0

# Must be > 0, else the default applies.
BITBUCKET_TIMEOUT_MS=30000

# Retries for transient failures (network / 429 / 5xx). 0 disables.
BITBUCKET_MAX_RETRIES=2

# Renamed. Still accepts: BITBUCKET_DEFAULT_PAGELEN.
# BITBUCKET_DEFAULT_LIMIT=25

# Renamed. Still accepts: BITBUCKET_MAX_PAGELEN.
# BITBUCKET_MAX_LIMIT=100

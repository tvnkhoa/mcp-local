  "hubs": {
    "codebase-index-mcp/src/middleware/freshness.ts": {
      "why": "the R1 freshness gate wraps every read tool, so @dist would select the whole suite; these harnesses assert its own behaviour (refresh, deadline, lock, repair, scoped notes); unit: freshness.test.ts, freshnessRepair.test.ts",
      "harnesses": {
        "test:freshness-worker": "the gate's refresh runs in the refresh worker; asserts its states and lanes",
        "test:query-refresh": "a query refreshes a dirty tree through the gate (IX-B)",
        "test:refresh-deadline": "imports dist/middleware/freshness.js; the refresh budget and deadline",
        "test:index-lock-contention": "the gate's lock files against a concurrent index run",
        "test:field-access-vue": "Release D note (1): the freshness note is scoped to index-derived parts",
        "test:detect-changes-rename": "the gate prunes a git-mv'd path; polls until state leaves refreshing",
        "test:query-graph-timeout": "the gate's overhead is part of the timed call",
        "test:refactor-profiles": "a dirty tree makes the first call carry a freshness block"
      }
    },
    "codebase-index-mcp/src/resources/resourceHandler.ts": {
      "why": "serves MCP resources/list and resources/read; only these harnesses call them",
      "harnesses": {
        "test:server-envelopes": "resources/list + resources/read envelopes (buildRepoResources)",
        "test:issue-049-shapes": "readResource payload shapes"
      }
    },
    "codebase-index-mcp/src/repositories/vectorSearchWorkerClient.ts": {
      "why": "the KNN lane's worker client; only these harnesses drive the worker; unit: vectorSearchWorkerClient.test.ts",
      "harnesses": {
        "test:freshness-worker": "KNN lanes warm on first use, join a scan in flight, are cleared on run landed",
        "test:index-lock-contention": "vector search while an index run holds the lock",
        "test:bundle-boot": "the worker URL must sit beside its client in dist/bundle; sqlite-vec loads"
      }
    },
    "codebase-index-mcp/src/services/indexing/indexPipeline.ts": {
      "why": "every harness indexes through it; these assert the pipeline itself: full vs incremental per lane, run bookkeeping, INDEX_VERSION, determinism, jobs, worktree seed; unit: services/indexing/*.test.ts",
      "harnesses": {
        "test:seed-conformance": "two full runs of one tree compare EQUAL, a renamed function DIFFERENT",
        "test:node-identity": "two identical runs agree on edge counts (MCP-ISSUE-032)",
        "test:index-jobs": "index_repository as a server-side job, runs reach ok in order",
        "test:register-worktree": "a seeded worktree index then incremental runs",
        "test:query-refresh": "incremental refresh of a dirty tree",
        "test:server-envelopes": "advertised INDEX_VERSION / annotation key",
        "test:text-json-lane": "full vs incremental for the text/json lane",
        "test:python-gaps": "full vs incremental for the Python lane",
        "test:css-symbols": "full vs incremental for the CSS lane",
        "test:sql-lane": "full vs incremental for the SQL lane",
        "test:html-svg": "full vs incremental for the HTML/SVG lane",
        "test:literal-cap-profiles": "incremental runs keep the literal caps"
      }
    },
    "codebase-index-mcp/package.json": {
      "why": "its scripts are the suite and its dependencies feed the bundle; a test:* script it adds is mapped in the same row",
      "harnesses": {
        "test:test-select": "suite discovery from package.json scripts; every script has a map entry",
        "test:bundle-boot": "dependencies / externals: the bundle boots and loads its native modules",
        "test:server-envelopes": "the advertised version equals package.json version"
      }
    }
  },

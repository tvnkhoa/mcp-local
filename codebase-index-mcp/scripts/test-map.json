{
  "$comment": "Which codebase-index harnesses a change needs: run-tests.mjs --changed. Paths are relative to the workspace root. A changed file that no glob here covers runs the WHOLE suite; skip lists only other servers and pure docs; none lists, one explicit path each, root files no harness loads. test:test-select fails when a suite script has no entry. Rules: scripts/lib/testSelect.mjs.",
  "always": [
    "test:unit",
    "guard:no-llm-runtime"
  ],
  "skip": {
    "other server": [
      "postgres-mcp/**",
      "sqlserver-mcp/**",
      "observe-mcp/**",
      "bitbucket-mcp/**",
      "board-mcp/**"
    ],
    "docs": [
      "docs/**",
      "*.md",
      "packages/*/README.md",
      ".claude/**/*.md"
    ]
  },
  "none": [
    "scripts/serve-http.mjs",
    "scripts/worktree.mjs",
    "scripts/heavy-lock.mjs",
    "scripts/mcp-doctor.mjs",
    "scripts/install-mcp.mjs",
    ".github/**"
  ],
  "unit": [
    "codebase-index-mcp/src/**/*.test.ts"
  ],
  "groups": {
    "dist": [
      "codebase-index-mcp/src/**",
      "codebase-index-mcp/package.json",
      "codebase-index-mcp/package-lock.json",
      "codebase-index-mcp/tsconfig*.json",
      "codebase-index-mcp/scripts/test/_*.mjs",
      "packages/**",
      "package.json",
      "package-lock.json",
      "tsconfig*.json"
    ],
    "self": [
      "codebase-index-mcp/*.md",
      "codebase-index-mcp/docs/**",
      "codebase-index-mcp/.claude/**",
      "codebase-index-mcp/skill/**",
      "codebase-index-mcp/.env.example"
    ]

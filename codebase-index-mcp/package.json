{
  "name": "codebase-index-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Internal MCP server for codebase indexing and graph analysis",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node scripts/run-tests.mjs --integration-only",
    "smoke": "node scripts/smoke-test.mjs",
    "guard:no-llm-runtime": "node scripts/guard-no-llm-runtime.mjs",
    "test:setup-config": "node scripts/test/test-setup-config.mjs",
    "test:harness-db-isolation": "node scripts/test/test-harness-db-isolation.mjs",
    "test:endpoint-bridge": "node scripts/test/test-endpoint-bridge.mjs",
    "test:endpoint-fallback-context": "node scripts/test/test-endpoint-fallback-context.mjs",
    "test:csharp-inheritance-bridge": "node scripts/test/test-csharp-inheritance-bridge.mjs",
    "test:csharp-type-refs": "node scripts/test/test-csharp-type-refs.mjs",
    "test:node-identity": "node scripts/test/test-node-identity.mjs",
    "test:csharp-using-bridge": "node scripts/test/test-csharp-using-bridge.mjs",
    "test:nuget-bridge": "node scripts/test/test-nuget-bridge.mjs",
    "test:minimal-api-guard": "node scripts/test/test-minimal-api-guard.mjs",
    "test:wiring-note": "node scripts/test/test-wiring-note.mjs",
    "test:issue-049-shapes": "node scripts/test/test-issue-049-shapes.mjs",
    "test:bus-edges": "node scripts/test/test-bus-edges.mjs",
    "test:search-ranking": "node scripts/test/test-search-ranking.mjs",
    "test:interface-dispatch": "node scripts/test/test-interface-dispatch.mjs",
    "test:call-chain-interface": "node scripts/test/test-call-chain-interface.mjs",
    "test:base-class-dispatch": "node scripts/test/test-base-class-dispatch.mjs",
    "test:benchmark-fixture": "node scripts/test/test-benchmark-fixture.mjs",
    "test:string-literals": "node scripts/test/test-string-literals.mjs",
    "test:search-regex": "node scripts/test/test-search-regex.mjs",
    "test:issue-refinements": "node scripts/test/test-issue-refinements.mjs",
    "verify:enhancements": "node scripts/verify-enhancements.mjs",
    "test:profile-responses": "node scripts/test/test-profile-responses.mjs",
    "test:refactor-profiles": "node scripts/test/test-refactor-preview-profiles.mjs",
    "test:refactor-engine": "node scripts/test/test-refactor-engine.mjs",
    "test:link-tests-boost": "node scripts/test/test-link-tests-boost.mjs",
    "test:field-access-rhs": "node scripts/test/test-field-access-rhs.mjs",
    "test:change-value-representation": "node scripts/test/test-change-value-representation.mjs",
    "test:persistence-mapping": "node scripts/test/test-persistence-mapping.mjs",
    "test:value-contract-impact": "node scripts/test/test-value-contract-impact.mjs",
    "benchmark:plan": "node scripts/benchmark-plan-mode.mjs",
    "benchmark:plan:check": "node scripts/benchmark-plan-mode.mjs",
    "test:impact-join-parity": "node scripts/test/test-impact-join-parity.mjs",
    "test:server-envelopes": "node scripts/test/test-server-envelopes.mjs",

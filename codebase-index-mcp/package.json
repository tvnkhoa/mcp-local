{
  "name": "codebase-index-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Internal MCP server for codebase indexing and graph analysis",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "guard:no-llm-runtime": "node scripts/guard-no-llm-runtime.mjs",
    "test:setup-config": "node scripts/test-setup-config.mjs",
    "test:endpoint-bridge": "node scripts/test-endpoint-bridge.mjs",
    "test:endpoint-fallback-context": "node scripts/test-endpoint-fallback-context.mjs",
    "test:csharp-inheritance-bridge": "node scripts/test-csharp-inheritance-bridge.mjs",
    "test:csharp-using-bridge": "node scripts/test-csharp-using-bridge.mjs",
    "test:nuget-bridge": "node scripts/test-nuget-bridge.mjs",
    "test:minimal-api-guard": "node scripts/test-minimal-api-guard.mjs",
    "benchmark:plan": "node scripts/benchmark-plan-mode.mjs",
    "benchmark:plan:check": "node scripts/benchmark-plan-mode.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "glob": "^11.0.1",
    "sqlite-vec": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

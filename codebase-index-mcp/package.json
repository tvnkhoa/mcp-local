{
  "name": "codebase-index-mcp",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Internal MCP server for codebase indexing and graph analysis",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "benchmark:plan": "node scripts/benchmark-plan-mode.mjs",
    "benchmark:plan:check": "node scripts/benchmark-plan-mode.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "glob": "^11.0.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

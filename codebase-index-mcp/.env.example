# codebase-index-mcp — environment configuration
# Copy the values you need into the `env` block of your ~/.claude.json server entry
# (or a local .env when running `npm run dev`). Never commit real secrets.

# --- Required ---------------------------------------------------------------
# Comma-separated ABSOLUTE paths the server is allowed to index. The ONLY
# required variable. Use the exact path you pass to list_repositories (do not
# change drive-letter casing or slash style).
CODEBASE_INDEX_ALLOWED_ROOTS=D:/1.SourceCode/mcp-local

# --- Storage ----------------------------------------------------------------
# Where the SQLite code graph is stored. Defaults next to the workspace.
CODEBASE_INDEX_DB_PATH=D:/1.SourceCode/mcp-local/mcp-codebase-index.db

# --- Docs lane (off by default) ---------------------------------------------
CODEBASE_INDEX_DOCS_INDEXING_ENABLED=false
CODEBASE_INDEX_DOCS_TOOLS_ENABLED=false

# --- Indexing tuning (safe defaults) ----------------------------------------
# CODEBASE_INDEX_MAX_FILES_PER_RUN=10000
# CODEBASE_INDEX_LARGE_REPO_PROFILE=false
# LARGE_FILE_THRESHOLD_BYTES=524288
# CODEBASE_INDEX_PARSE_JOB_TIMEOUT_MS=60000

# --- Watch (off by default) -------------------------------------------------
CODEBASE_INDEX_WATCH_AUTO_START=false
# CODEBASE_INDEX_WATCH_DEBOUNCE_MS=500

# --- Refactor approval ------------------------------------------------------
# HMAC secret for refactor approval tokens. Auto-generated per process when
# empty; set it to keep approval tokens valid across restarts.
CODEBASE_INDEX_REFACTOR_APPROVAL_SECRET=
# CODEBASE_INDEX_REFACTOR_PREVIEW_TTL_MS=1800000
# CODEBASE_INDEX_REFACTOR_STRICT_APPROVAL=false

# --- Telemetry (off by default) ---------------------------------------------
CODEBASE_INDEX_TELEMETRY_ENABLED=false
# CODEBASE_INDEX_TELEMETRY_SAMPLE_RATE=1.0

# --- Hard block -------------------------------------------------------------
# Runtime LLM invocation is prohibited by design. Setting this to true aborts
# startup. Do NOT enable.
# CODEBASE_INDEX_LLM_ENABLED=false

# codebase-index-mcp — environment configuration
#
# @generated by scripts/generate-env.mjs from @mcp/manifest — do not edit by hand.
# Run `npm run generate:env` after changing the manifest; `npm run generate:check` fails on drift.
#
# Copy the values you need into the `env` block of your ~/.claude.json server entry (or a
# local .env when running `npm run dev`). Never commit real secrets.
#
# Uncommented lines are what the installer writes for you. Commented lines are tuning knobs:
# the value shown is the server's own fallback, so setting one PINS it — leave it alone unless
# you mean to override.

# --- Required ---------------------------------------------------------------
# The ONLY required var. Comma-separated absolute paths the server may index.
# Use the exact path `list_repositories` reports — changing drive-letter
# casing or slash style causes allowlist rejection.
CODEBASE_INDEX_ALLOWED_ROOTS=D:/1.SourceCode/mcp-local

# --- Storage ----------------------------------------------------------------
# Where the code graph is stored — one file holds every repo, scoped by
# repoId. Four names were in play before S-40; this is the one actually in
# use. Note that the server's own fallback when this is unset is the RELATIVE
# path ./codebase-index.db, which lands wherever the process was started, so
# leaving it set is what keeps the index in one place.
CODEBASE_INDEX_DB_PATH=D:/1.SourceCode/mcp-local/mcp-local-index-central.db

# --- Docs lane (off by default) ---------------------------------------------
CODEBASE_INDEX_DOCS_INDEXING_ENABLED=false

CODEBASE_INDEX_DOCS_TOOLS_ENABLED=false

# --- Telemetry (off by default) ---------------------------------------------
CODEBASE_INDEX_TELEMETRY_ENABLED=false

# Ratio 0–1. Only meaningful when telemetry is enabled.
# CODEBASE_INDEX_TELEMETRY_SAMPLE_RATE=1

# --- Watch ------------------------------------------------------------------
# Watchless by default, per the workspace's MCP hard-mode policy.
CODEBASE_INDEX_WATCH_AUTO_START=false

# Defaults to TRUE — only the active repo is watched. The one boolean here
# whose default is not false.
# CODEBASE_INDEX_WATCH_ACTIVE_ONLY=true

# Idle watcher stop timeout. Clamped to 5s–24h.
# CODEBASE_INDEX_WATCH_ACTIVE_TTL_MS=900000

# CODEBASE_INDEX_WATCH_DEBOUNCE_MS=500

# CODEBASE_INDEX_WATCH_BATCH_SIZE=

# CODEBASE_INDEX_WATCH_MAX_FILES_PER_RUN=

# CODEBASE_INDEX_WATCH_MAX_QUEUED_EVENTS=

# Comma-separated repoIds to auto-watch at boot. Unset = none.
# CODEBASE_INDEX_AUTO_WATCH_REPOS=

# --- Indexing limits --------------------------------------------------------
# CODEBASE_INDEX_MAX_FILES_PER_RUN=20000

# CODEBASE_INDEX_MAX_FILE_SIZE_BYTES=500000

# 0 = no large-file special casing.
# CODEBASE_INDEX_LARGE_FILE_THRESHOLD_BYTES=0

# Hard ceiling on any tool's `limit`.
# CODEBASE_INDEX_MAX_RESULT_LIMIT=500

# Hard ceiling on traversal `depth`.
# CODEBASE_INDEX_MAX_DEPTH=5

# Performance profile: auto | standard/off | large/balanced |
# very-large/aggressive.
# CODEBASE_INDEX_LARGE_REPO_PROFILE=auto

# --- Parser tuning ----------------------------------------------------------
# Worker-pool size. Unset = derived from CPU count.
# CODEBASE_INDEX_PARSE_WORKERS=

# Per-file parse timeout.
# CODEBASE_INDEX_PARSE_TIMEOUT_MS=5000

# Whole-batch timeout.
# CODEBASE_INDEX_PARSE_JOB_TIMEOUT_MS=20000

# Override; unset = the extractor's own limit.
# CODEBASE_INDEX_MAX_CALL_EDGES_PER_FILE=

# Per-file TYPE_REF ceiling. Bounds this lane by volume instead of by
# confidence (MCP-ISSUE-038); unset = the profile default.
# CODEBASE_INDEX_MAX_TYPE_REF_EDGES_PER_FILE=

# Ratio 0–1. Drops low-confidence edges at extraction time.
# CODEBASE_INDEX_MIN_EDGE_CONFIDENCE=

# CODEBASE_INDEX_MAX_STRING_LITERALS_PER_FILE=

# CODEBASE_INDEX_MIN_STRING_LITERAL_LENGTH=

# Extra NuGet package → namespace mappings for .NET dependency edges.
# NUGET_NAMESPACE_MAP=

# --- Write batching ---------------------------------------------------------
# Files per SQLite sub-transaction.
# CODEBASE_INDEX_SUBTX_SIZE=20

# WAL checkpoint cadence.
# CODEBASE_INDEX_CHECKPOINT_EVERY_N_BATCHES=1

# --- Post-resolve phase -----------------------------------------------------
# Cap on unresolved pairs resolved after extraction. Profile-dependent when
# unset (0 = unlimited for standard/very-large, 120000 for large).
# CODEBASE_INDEX_MAX_UNRESOLVED_RESOLVE_ROWS=

# CODEBASE_INDEX_POST_RESOLVE_TYPE_REFS=true

# CODEBASE_INDEX_POST_RESOLVE_PROPERTY_REFS=true

# Namespaces treated as shared when resolving cross-repo edges.
# CODEBASE_INDEX_CROSS_REPO_NAMESPACES=

# false disables trigram vector search entirely (no in-memory fallback) — a
# control for isolating vector-assisted resolution.
# CODEBASE_INDEX_VECTOR_ENABLED=true

# --- Refactor approval ------------------------------------------------------
# HMAC secret for refactor approval tokens. Auto-generated per process if
# unset; set it to keep tokens valid across restarts.
# CODEBASE_INDEX_REFACTOR_APPROVAL_SECRET=

# Preview/token lifetime — 30 minutes.
# CODEBASE_INDEX_REFACTOR_PREVIEW_TTL_MS=1800000

# When true, startup fails unless CODEBASE_INDEX_REFACTOR_APPROVAL_SECRET is
# set.
# CODEBASE_INDEX_REFACTOR_STRICT_APPROVAL=false

# --- Diagnostics ------------------------------------------------------------
# Enables verbose index-progress logging on stderr.
# CODEBASE_INDEX_INDEX_LOG=

# --- Hard block — do not enable ---------------------------------------------
# Runtime LLM invocation is prohibited by design. Setting this to true ABORTS
# STARTUP, and `guard:no-llm-runtime` statically verifies no LLM client is
# importable. Declared here so the constraint is documented, not so it can be
# turned on.
# CODEBASE_INDEX_LLM_ENABLED=false

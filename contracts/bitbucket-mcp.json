          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "q": {
            "type": "string"
          },
          "repoSlug": {
            "description": "Repo slug (default: BITBUCKET_DEFAULT_REPO)",
            "type": "string"
          },
          "sort": {
            "description": "e.g. -updated_on",
            "type": "string"
          },
          "state": {
            "enum": [
              "OPEN",
              "MERGED",
              "DECLINED",
              "SUPERSEDED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "list_pull_requests"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "List repositories in the configured workspace. Optional role filter (owner/admin/contributor/member), free-text `q` (BBQL), and `sort`.",
      "inputSchema": {

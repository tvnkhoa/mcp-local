{
  "server": "bitbucket-mcp",
  "toolCount": 12,
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Create a pull request. Disabled unless BITBUCKET_WRITE_ENABLED=true. Pass dryRun:true to preview the request payload without calling the API.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "closeSourceBranch": {
            "description": "Delete source branch on merge",
            "type": "boolean"
          },
          "description": {
            "description": "PR description (Markdown)",
            "type": "string"
          },
          "destinationBranch": {
            "description": "Destination branch (default: repo main branch)",
            "type": "string"
          },
          "dryRun": {
            "description": "Preview the payload without creating the PR",
            "type": "boolean"
          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "repoSlug": {
            "description": "Repo slug (default: BITBUCKET_DEFAULT_REPO)",
            "type": "string"
          },
          "reviewers": {
            "description": "Reviewer UUIDs (with or without braces) or account_ids",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sourceBranch": {
            "description": "Source branch name (the branch with your changes)",
            "type": "string"
          },
          "title": {
            "description": "PR title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "sourceBranch"
        ],
        "type": "object"
      },
      "name": "create_pull_request"
    },
    {
      "annotations": {

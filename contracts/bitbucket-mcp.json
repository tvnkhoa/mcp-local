    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Read the log of one pipeline step. Returns the LAST maxBytes bytes (default 256 KiB, max 1 MiB) because that is where a failure is. A step that has not started yet has no log and answers 404.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "maxBytes": {
            "description": "Tail size in bytes (default 262144, max 1048576)",
            "maximum": 1048576,
            "minimum": 1,
            "type": "integer"
          },
          "pipelineUuid": {
            "description": "Pipeline UUID (braces optional) or build number",
            "type": "string"
          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "repoSlug": {
            "description": "Repo slug (default: BITBUCKET_DEFAULT_REPO)",
            "type": "string"
          },
          "stepUuid": {
            "description": "Step UUID (braces optional)",
            "type": "string"
          }
        },
        "required": [
          "pipelineUuid",
          "stepUuid"
        ],
        "type": "object"
      },
      "name": "get_pipeline_step_log"
    },

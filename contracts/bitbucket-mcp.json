      },
      "description": "Compare two refs (branch, tag or SHA) like `git diff base...head` plus `git rev-list --left-right --count`: merge base, how many commits head is ahead of / behind base (capped at 500, shown as \"≥500\"), and the files head changed since the merge base. statOnly:false adds the unified diff, cut at maxDiffBytes (default 256 KiB, max 1 MiB; see diffTruncated). `path` (a file or a directory) limits files, totals and the diff to it, like `git diff base...head -- path`; ahead/behind stay branch-wide. A directory is filtered over at most 5000 changed files.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "description": "The ref compared against, e.g. master or origin's develop",
            "type": "string"
          },
          "head": {
            "description": "The ref whose changes are listed, e.g. a feature branch",
            "type": "string"
          },
          "maxDiffBytes": {
            "description": "Diff bytes to return when statOnly is false (default 262144, max 1048576)",
            "maximum": 1048576,
            "minimum": 1,
            "type": "integer"
          },
          "maxFiles": {
            "description": "File rows to return (default 200, max 500)",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "Only this file or directory (repo-relative)",
            "type": "string"
          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "repoSlug": {
            "description": "Repo slug (default: BITBUCKET_DEFAULT_REPO)",
            "type": "string"
          },
          "statOnly": {
            "description": "Default true: files and counts only, no diff text",
            "type": "boolean"
          }
        },
        "required": [
          "base",
          "head"
        ],
        "type": "object"
      },
      "name": "compare_refs"
    },

          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "q": {
            "description": "Bitbucket query, e.g. name ~ \"api\"",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "contributor",
              "member"
            ],
            "type": "string"
          },
          "sort": {
            "description": "e.g. -updated_on",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "list_repositories"
    }

      },
      "description": "Create the commit a commit_files_preview planned, from its previewId + approvalToken — the exact previewed content, nothing else. Re-checks that the parent is still the branch head, and Bitbucket asserts it again (refusing with 400/409). Never forces. Disabled unless BITBUCKET_COMMIT_ENABLED=true. For a shared branch the result includes a reconcile script for the local worktree: it refuses unless local HEAD is still the parent and every committed path matches, then moves the branch and resets only those index entries, leaving everyone else's staged work alone.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "approvalToken": {
            "description": "From commit_files_preview",
            "type": "string"
          },
          "previewId": {
            "description": "From commit_files_preview",
            "type": "string"
          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          }
        },
        "required": [
          "previewId",
          "approvalToken"
        ],
        "type": "object"
      },
      "name": "commit_files_apply"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Plan ONE commit on a branch from text files (add/modify) and deletions — server-side, so no local index is involved and no one else's staged work can be swept in. Checks the branch is allowlisted (BITBUCKET_COMMIT_BRANCHES, or BITBUCKET_COMMIT_SHARED_BRANCHES for a branch checked out in a shared worktree), that `parent` IS the branch head (no force, ever — the repo has no server-side protection, so this check is the guard), and what each path does. Returns previewId + approvalToken for commit_files_apply (15 minutes, single use). Changes nothing; works with commits disabled.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "author": {
            "description": "Optional \"Name <email>\" (default: the token's user)",
            "type": "string"
          },
          "branch": {
            "description": "Branch to commit on; created from `parent` if it does not exist (non-shared branches only)",
            "type": "string"
          },
          "files": {
            "description": "Up to 50 changes; text only, 512 KiB per file, 1024 KiB total",
            "items": {
              "additionalProperties": false,
              "properties": {
                "content": {
                  "description": "Full new text content (add or modify)",
                  "type": "string"
                },
                "delete": {
                  "description": "true to delete the path (omit content)",
                  "type": "boolean"
                },
                "path": {
                  "description": "Repo-relative path",
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
          },
          "message": {
            "description": "Commit message",
            "type": "string"
          },
          "parent": {
            "description": "The commit you built on. Must be the branch head now",
            "type": "string"
          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "repoSlug": {
            "description": "Repo slug (default: BITBUCKET_DEFAULT_REPO)",
            "type": "string"
          }
        },
        "required": [
          "branch",
          "parent",
          "message",
          "files"
        ],
        "type": "object"
      },
      "name": "commit_files_preview"
    },
    {
      "annotations": {

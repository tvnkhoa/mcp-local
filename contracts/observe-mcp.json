    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Discover the fields of a stream by sampling recent rows (no fixed schema assumptions). Returns each field with its observed JSON types and how many sampled rows had a non-null value.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "type": "string"
          },
          "environment": {
            "description": "Which configured environment to query (default: the server's default; see list_environments)",
            "type": "string"
          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "sample": {
            "description": "Rows to sample for field discovery (default 5, max 50)",
            "type": "number"
          },
          "start": {
            "type": "string"
          },
          "stream": {
            "description": "Stream to inspect (default: the configured logs stream)",
            "type": "string"
          },
          "time": {
            "description": "Relative window to sample from (default 1h)",
            "type": "string"
          },
          "type": {
            "enum": [
              "logs",
              "traces",
              "metrics"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "describe_stream"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": true
      },
      "description": "Discover which services are emitting into an environment: per-service log volume, error/warning counts, first/last seen, and (with include:\"codeLinks\") the application namespaces that identify the owning code. Covers both the logs and traces lanes. Use this instead of assuming a fixed service list.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "description": "Absolute end (ISO 8601 or epoch ms)",
            "type": "string"
          },
          "environment": {
            "description": "Which configured environment to query (default: the server's default; see list_environments)",
            "type": "string"
          },
          "include": {
            "description": "Optional extra sections",
            "items": {
              "enum": [
                "contexts",
                "fields",
                "streams",
                "codeLinks"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "lane": {
            "enum": [
              "logs",
              "traces",
              "both"
            ],
            "type": "string"
          },
          "limit": {
            "description": "Max services per lane (default 200); servicesTruncated says when it bit",
            "type": "number"
          },
          "profile": {
            "enum": [
              "nano",
              "compact",
              "standard",
              "verbose"
            ],
            "type": "string"
          },
          "sample": {
            "description": "Rows to sample when include contains \"fields\" (default 25, max 50)",
            "type": "number"
          },
          "service": {
            "description": "Restrict contexts/fields to one service_name",
            "type": "string"
          },
          "source": {
            "enum": [
              "live",
              "catalog"
            ],
            "type": "string"
          },
          "start": {
            "description": "Absolute start (ISO 8601 or epoch ms)",
            "type": "string"
          },
          "stream": {
            "description": "Override the environment's logs stream",
            "type": "string"
          },
          "time": {
            "description": "Relative window ending now, e.g. 24h, 7d (default 1h)",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "discover_services"
    },

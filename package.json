{
  "name": "mcp-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace of local MCP servers with a unified installer, doctor, and auto-generated native skills.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run build:packages && node scripts/install-mcp.mjs",
    "mcp:install": "npm run build:packages && node scripts/install-mcp.mjs",
    "mcp:doctor": "node scripts/mcp-doctor.mjs",
    "mcp:uninstall": "node scripts/uninstall-mcp.mjs",
    "mcp:update": "node scripts/update-mcp.mjs",
    "build:packages": "tsc -b",
    "typecheck:packages": "tsc -b",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "clean:packages": "tsc -b --clean",
    "test:packages": "npm run test --workspaces --if-present",
    "guard:deps": "node packages/cli/dist/bin/mcp-platform.js guard deps --servers codebase-index-mcp,postgres-mcp,observe-mcp,bitbucket-mcp",
    "guard:convention": "node packages/cli/dist/bin/mcp-platform.js guard convention",
    "guard:all": "node packages/cli/dist/bin/mcp-platform.js guard all --servers codebase-index-mcp,postgres-mcp,observe-mcp,bitbucket-mcp",
    "install:servers": "node scripts/run-servers.mjs install",
    "build:servers": "node scripts/run-servers.mjs build",
    "typecheck:servers": "node scripts/run-servers.mjs typecheck --continue",
    "test:servers": "node scripts/run-servers.mjs test --continue",
    "smoke:servers": "node scripts/run-servers.mjs smoke --continue",
    "verify:servers": "npm run build:servers && npm run typecheck:servers && npm run test:servers",
    "verify:packages": "npm run build:packages && npm run typecheck:tests && npm run test:packages && npm run guard:all",
    "contracts:update": "node scripts/contract-snapshot.mjs",
    "contracts:check": "node scripts/contract-snapshot.mjs --check",
    "generate:tools": "node scripts/generate-tools.mjs",
    "generate:env": "node scripts/generate-env.mjs",
    "generate:docs": "node scripts/generate-docs.mjs",
    "generate:all": "npm run generate:tools && npm run build:packages && npm run generate:env && npm run generate:docs",
    "generate:check": "node scripts/generate-tools.mjs --check && node scripts/generate-env.mjs --check && node scripts/generate-docs.mjs --check",
    "new:server": "node scripts/new-server.mjs",
    "verify:all": "npm run verify:packages && npm run verify:servers && npm run contracts:check && npm run generate:check",
    "verify:live": "npm run smoke:servers"
  }
}
